<!-- {{ function_name }} 列表页（由 cicada 代码生成器产出）。 -->
<template>
  <div class="app-container">
    <el-form :model="query" inline>
{% for c in query_columns %}      <el-form-item label="{{ c.comment }}">
{% if c.dict_type %}        <el-select v-model="query.{{ c.field }}" clearable placeholder="全部" style="width: 160px">
          <!-- dict: {{ c.dict_type }}，按需渲染字典项 -->
        </el-select>
{% elif c.temporal == 'datetime' or c.temporal == 'date' %}        <el-date-picker v-model="query.{{ c.field }}" type="{{ 'date' if c.temporal == 'date' else 'datetime' }}" value-format="{{ 'YYYY-MM-DD' if c.temporal == 'date' else 'YYYY-MM-DDTHH:mm:ssZ' }}" />
{% else %}        <el-input v-model="query.{{ c.field }}" clearable placeholder="{{ c.comment }}" style="width: 180px" />
{% endif %}      </el-form-item>
{% endfor %}      <el-form-item>
        <el-button type="primary" @click="load">查询</el-button>
        <el-button v-perm="'{{ perms[1] }}'" type="success" @click="openCreate">新增</el-button>
      </el-form-item>
    </el-form>

    <el-table :data="rows" v-loading="loading" border>
{% for c in list_columns %}      <el-table-column prop="{{ c.field }}" label="{{ c.comment }}" show-overflow-tooltip />
{% endfor %}      <el-table-column label="操作" width="160" fixed="right">
        <template #default="{ row }">
          <el-button v-perm="'{{ perms[2] }}'" link type="primary" @click="openEdit(row)">修改</el-button>
          <el-button v-perm="'{{ perms[3] }}'" link type="danger" @click="remove(row)">删除</el-button>
        </template>
      </el-table-column>
    </el-table>

    <el-pagination
      v-model:current-page="query.page"
      v-model:page-size="query.page_size"
      :total="total"
      @current-change="load"
    />

    <el-dialog v-model="dialogVisible" :title="dialogTitle" width="640px">
      <el-form :model="form" label-width="120px">
{% for c in upsert_columns %}        <el-form-item label="{{ c.comment }}"{% if c.is_required %} required{% endif %}>
{% if c.dict_type %}          <el-select v-model="form.{{ c.field }}" style="width: 100%"><!-- dict: {{ c.dict_type }} --></el-select>
{% elif c.html_type == 'textarea' or c.html_type == 'editor' %}          <el-input v-model="form.{{ c.field }}" type="textarea" :rows="3" />
{% elif c.html_type == 'switch' %}          <el-switch v-model="form.{{ c.field }}" />
{% elif c.temporal == 'datetime' %}          <el-date-picker v-model="form.{{ c.field }}" type="datetime" value-format="YYYY-MM-DDTHH:mm:ssZ" />
{% elif c.temporal == 'date' %}          <el-date-picker v-model="form.{{ c.field }}" type="date" value-format="YYYY-MM-DD" />
{% elif c.temporal == 'time' %}          <el-time-picker v-model="form.{{ c.field }}" value-format="HH:mm:ss" />
{% else %}          <el-input v-model="form.{{ c.field }}" />
{% endif %}        </el-form-item>
{% endfor %}      </el-form>
      <template #footer>
        <el-button @click="dialogVisible = false">取消</el-button>
        <el-button type="primary" @click="submit">确定</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup lang="ts">
import { onMounted, reactive, ref } from 'vue';
import {
  list{{ class_name }},
  add{{ class_name }},
  update{{ class_name }},
  del{{ class_name }},
  type {{ class_name }}Vo,
  type {{ class_name }}Query,
} from '@/api/{{ module_name }}/{{ business_name }}';

const loading = ref(false);
const rows = ref<{{ class_name }}Vo[]>([]);
const total = ref(0);
const query = reactive<{{ class_name }}Query>({ page: 1, page_size: 20 });
const dialogVisible = ref(false);
const dialogTitle = ref('');
const form = ref<Partial<{{ class_name }}Vo>>({});
let editingId: {{ pk_ts_type }} | null = null;

async function load() {
  loading.value = true;
  try {
    const data = await list{{ class_name }}(query);
    rows.value = data.items;
    total.value = data.total;
  } finally {
    loading.value = false;
  }
}

function openCreate() {
  editingId = null;
  dialogTitle.value = '新增{{ function_name }}';
  form.value = {};
  dialogVisible.value = true;
}

function openEdit(row: {{ class_name }}Vo) {
  editingId = row.{{ pk.field }};
  dialogTitle.value = '修改{{ function_name }}';
  form.value = { ...row };
  dialogVisible.value = true;
}

async function submit() {
  if (editingId === null) {
    await add{{ class_name }}(form.value);
  } else {
    await update{{ class_name }}(editingId, form.value);
  }
  dialogVisible.value = false;
  load();
}

async function remove(row: {{ class_name }}Vo) {
  await del{{ class_name }}(row.{{ pk.field }});
  load();
}

onMounted(load);
</script>
