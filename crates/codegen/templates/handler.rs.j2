#[cicada_macros::require_perm("{{ perms[0] }}")]
pub async fn list_models(
    State(state): State<AppState>,
    ctx: RequestContextExt,
    Query(q): Query<{{ class_name }}ListQuery>,
) -> Result<Json<{{ class_name }}Page>, ApiErr> {
    let ctx = ctx.into_inner();
    if ctx.principal.is_none() {
        return Err(unauthorized());
    }
{% if has_query %}    let mut query = ScopedQuery::<Entity>::open().scoped(&ctx.scope());
{% for c in query_columns %}    if let Some(v) = q.{{ c.field }}{% if c.is_string %}.filter(|s| !s.is_empty()){% endif %} {
        query = query.filter(Column::{{ c.pascal }}.{{ c.filter_method }}({{ c.filter_arg }}));
    }
{% endfor %}{% else %}    let query = ScopedQuery::<Entity>::open().scoped(&ctx.scope());
{% endif %}
    let page = q.page.unwrap_or(1).max(1);
    let page_size = q.page_size.unwrap_or(20).clamp(1, 200);
    let paged = query
        .order_by(Column::{{ pk.pascal }})
        .fetch_page(state.db.conn(), page, page_size)
        .await
        .map_err(db_error)?;
    Ok(Json({{ class_name }}Page {
        items: paged.items.into_iter().map({{ class_name }}Vo::from).collect(),
        total: paged.total,
        page: paged.page,
        page_size: paged.page_size,
    }))
}

{% if is_tree %}
/// 树形列表：一次取回受数据范围约束的全部行，再按 `{{ tree_parent_field }}` 组装成森林。
///
/// 树表不做分页（分页会把子树切碎）；定位/筛选仍走 `{{ class_name }}ListQuery` 的查询项。
#[utoipa::path(
    get,
    path = "{{ route_base }}/tree",
    params({{ class_name }}ListQuery),
    responses((status = 200, description = "{{ function_name }}树（受数据范围约束）", body = [{{ class_name }}Vo]))
)]
#[cicada_macros::require_perm("{{ perms[0] }}")]
pub async fn tree_models(
    State(state): State<AppState>,
    ctx: RequestContextExt,
    Query(q): Query<{{ class_name }}ListQuery>,
) -> Result<Json<Vec<{{ class_name }}Vo>>, ApiErr> {
    let ctx = ctx.into_inner();
    if ctx.principal.is_none() {
        return Err(unauthorized());
    }
{% if has_query %}    let mut query = ScopedQuery::<Entity>::open().scoped(&ctx.scope());
{% for c in query_columns %}    if let Some(v) = q.{{ c.field }}{% if c.is_string %}.filter(|s| !s.is_empty()){% endif %} {
        query = query.filter(Column::{{ c.pascal }}.{{ c.filter_method }}({{ c.filter_arg }}));
    }
{% endfor %}{% else %}    let query = ScopedQuery::<Entity>::open().scoped(&ctx.scope());
{% endif %}
    let rows = query
        .order_by(Column::{{ pk.pascal }})
        .all(state.db.conn())
        .await
        .map_err(db_error)?;
    let nodes: Vec<{{ class_name }}Vo> = rows.into_iter().map({{ class_name }}Vo::from).collect();
    Ok(Json(assemble_tree(nodes)))
}

/// 扁平行 → 森林。父键指向集合外、或自引用，都视为根；环引用不会 panic
/// （已消费节点再次被引用时跳过），保证任何脏数据下接口都不挂。
fn assemble_tree(nodes: Vec<{{ class_name }}Vo>) -> Vec<{{ class_name }}Vo> {
    use std::collections::HashMap;

    let index: HashMap<{{ pk_path_type }}, usize> = nodes
        .iter()
        .enumerate()
        .map(|(i, n)| (n.{{ tree_pk_field }}{% if pk_is_string %}.clone(){% endif %}, i))
        .collect();
    let mut buckets: Vec<Vec<usize>> = vec![Vec::new(); nodes.len()];
    let mut roots: Vec<usize> = Vec::new();
    for (i, n) in nodes.iter().enumerate() {
        match index.get(&n.{{ tree_parent_field }}).copied() {
            Some(parent) if parent != i => buckets[parent].push(i),
            _ => roots.push(i),
        }
    }

    fn take(
        i: usize,
        slots: &mut [Option<{{ class_name }}Vo>],
        buckets: &[Vec<usize>],
    ) -> Option<{{ class_name }}Vo> {
        let mut node = slots[i].take()?;
        let mut children = Vec::with_capacity(buckets[i].len());
        for &c in &buckets[i] {
            if let Some(child) = take(c, slots, buckets) {
                children.push(child);
            }
        }
        node.children = children;
        Some(node)
    }

    let mut slots: Vec<Option<{{ class_name }}Vo>> = nodes.into_iter().map(Some).collect();
    roots
        .iter()
        .filter_map(|&r| take(r, &mut slots, &buckets))
        .collect()
}

