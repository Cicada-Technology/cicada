#[cicada_macros::require_perm("{{ perms[0] }}")]
pub async fn get_model(
    State(state): State<AppState>,
    ctx: RequestContextExt,
    Path(pk): Path<{{ pk_path_type }}>,
) -> Result<Json<{{ class_name }}Vo>, ApiErr> {
    let ctx = ctx.into_inner();
    if ctx.principal.is_none() {
        return Err(unauthorized());
    }
    let model = ScopedQuery::<Entity>::open()
        .scoped(&ctx.scope())
        .filter(Column::{{ pk.pascal }}.eq(pk))
        .one(state.db.conn())
        .await
        .map_err(db_error)?
        .ok_or_else(not_found)?;
    Ok(Json({{ class_name }}Vo::from(model)))
}

