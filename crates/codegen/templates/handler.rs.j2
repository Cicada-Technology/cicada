#[cicada_macros::require_perm("{{ perms[3] }}")]
#[cicada_macros::audit(module = "{{ module_name }}", action = "{{ business_name }}:remove", kind = "delete")]
pub async fn delete_model(
    State(state): State<AppState>,
    ctx: RequestContextExt,
    Path(pk): Path<{{ pk_path_type }}>,
) -> Result<StatusCode, ApiErr> {
    let ctx = ctx.into_inner();
    if ctx.principal.is_none() {
        return Err(unauthorized());
    }
    ScopedQuery::<Entity>::open()
        .scoped(&ctx.scope())
        .filter(Column::{{ pk.pascal }}.eq({{ pk_clone }}))
        .one(state.db.conn())
        .await
        .map_err(db_error)?
        .ok_or_else(not_found)?;
    let now = chrono::Utc::now();
    ActiveModel {
        {{ pk.field }}: Set({{ pk_clone }}),
        deleted_at: Set(Some(now)),
{% if has_update_time %}        update_time: Set(Some(now)),
{% endif %}        ..Default::default()
    }
    .update(state.db.conn())
    .await
    .map_err(db_error)?;
    Ok(StatusCode::NO_CONTENT)
}

/// 路由声明。`*__perms()` / `*__audit()` 由 `#[require_perm]` / `#[audit]` 生成，
/// 交给装配器在启动期与 `Manifest.perms` 双向对账。
pub fn routes(_state: AppState) -> Routes {
    Routes::new()
        .route("{{ route_base }}", get(list_models), list_models__perms())
{% if is_tree %}        .route(
            "{{ route_base }}/tree",
            get(tree_models),
            tree_models__perms(),
        )
{% endif %}
        .route(
            "{{ route_base }}/{{ '{' }}{{ pk.field }}{{ '}' }}",
            get(get_model),
            get_model__perms(),
        )
        .route_audited(
            "{{ route_base }}",
            post(create_model),
            create_model__perms(),
            create_model__audit(),
        )
        .route_audited(
            "{{ route_base }}/{{ '{' }}{{ pk.field }}{{ '}' }}",
            put(update_model),
            update_model__perms(),
            update_model__audit(),
        )
        .route_audited(
            "{{ route_base }}/{{ '{' }}{{ pk.field }}{{ '}' }}",
            delete(delete_model),
            delete_model__perms(),
            delete_model__audit(),
        )
}
