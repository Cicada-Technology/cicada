#[cicada_macros::require_perm("{{ perms[1] }}")]
#[cicada_macros::audit(module = "{{ module_name }}", action = "{{ business_name }}:add", kind = "insert")]
pub async fn create_model(
    State(state): State<AppState>,
    ctx: RequestContextExt,
    Json(req): Json<{{ class_name }}Upsert>,
) -> Result<(StatusCode, Json<{{ class_name }}Vo>), ApiErr> {
    let ctx = ctx.into_inner();
    let Some(principal) = &ctx.principal else {
        return Err(unauthorized());
    };
    let active = ActiveModel {
        tenant_id: Set(ctx.tenant_id.get()),
{% for c in upsert_columns %}        {{ c.field }}: {{ c.insert_expr }},
{% endfor %}{% if has_create_by %}        create_by: Set(Some(principal.user_name.clone())),
{% endif %}{% if has_create_time %}        create_time: Set(chrono::Utc::now()),
{% endif %}        ..Default::default()
    };
    let model = active.insert(state.db.conn()).await.map_err(db_error)?;
    Ok((StatusCode::CREATED, Json({{ class_name }}Vo::from(model))))
}

#[utoipa::path(
    put,
    path = "{{ route_base }}/{{ '{' }}{{ pk.field }}{{ '}' }}",
    params(("{{ pk.field }}" = {{ pk_path_type }}, Path, description = "{{ pk.comment }}")),
    request_body = {{ class_name }}Upsert,
    responses((status = 200, description = "已更新", body = {{ class_name }}Vo), (status = 404, description = "不存在"))
)]
#[cicada_macros::require_perm("{{ perms[2] }}")]
#[cicada_macros::audit(module = "{{ module_name }}", action = "{{ business_name }}:edit", kind = "update")]
pub async fn update_model(
    State(state): State<AppState>,
    ctx: RequestContextExt,
    Path(pk): Path<{{ pk_path_type }}>,
    Json(req): Json<{{ class_name }}Upsert>,
) -> Result<Json<{{ class_name }}Vo>, ApiErr> {
    let ctx = ctx.into_inner();
    let Some(principal) = &ctx.principal else {
        return Err(unauthorized());
    };
    let existing = ScopedQuery::<Entity>::open()
        .scoped(&ctx.scope())
        .filter(Column::{{ pk.pascal }}.eq({{ pk_clone }}))
        .one(state.db.conn())
        .await
        .map_err(db_error)?
        .ok_or_else(not_found)?;
    ActiveModel {
        {{ pk.field }}: Set({{ pk_clone }}),
        tenant_id: Set(existing.tenant_id),
{% for c in upsert_columns %}        {{ c.field }}: {{ c.insert_expr }},
{% endfor %}{% if has_update_by %}        update_by: Set(Some(principal.user_name.clone())),
{% endif %}{% if has_update_time %}        update_time: Set(Some(chrono::Utc::now())),
{% endif %}        ..Default::default()
    }
    .update(state.db.conn())
    .await
    .map_err(db_error)?;
    let updated = Entity::find_by_id(pk)
        .one(state.db.conn())
        .await
        .map_err(db_error)?
        .ok_or_else(not_found)?;
    Ok(Json({{ class_name }}Vo::from(updated)))
}

